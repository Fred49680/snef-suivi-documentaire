{
  "version": 2,
  "env": {
    "NODE_VERSION": "18.x"
  },
  "builds": [
    {
      "src": "api/index.js",
      "use": "@vercel/node@3.0.0"
    }
  ],
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "/api/index.js"
    },
    {
      "src": "/(.*)",
      "dest": "/public/$1"
    }
  ]
}
