{
  "version": 2,
  "buildCommand": "npm install",
  "devCommand": "node server.js",
  "functions": {
    "api/index.js": {
      "runtime": "@vercel/node@latest"
    }
  },
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "/api/index.js"
    },
    {
      "src": "/(.*)",
      "dest": "/public/$1"
    }
  ]
}
